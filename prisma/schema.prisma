generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StoreStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

enum StoreConnectionType {
  GENERIC_API
  GITHUB_VERCEL
}

enum ProductStatus {
  IMPORTED
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum ImageType {
  GALLERY
  VARIANT
  DESCRIPTION
}

enum PublicationStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  ERROR
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  ORDERED_ALIEXPRESS
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  ORDERED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum EventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Store {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  baseUrl        String
  connectionType StoreConnectionType @default(GENERIC_API)
  apiEndpoint    String?

  githubOwner  String?
  githubRepo   String?
  githubBranch String?

  currency String      @default("BRL")
  status   StoreStatus @default(ACTIVE)

  publications Publication[]
  orders       Order[]
  events       IntegrationEvent[]

  brandProfile          Json?
  categoriesCache       Json?
  connectorCapabilities Json?
  lastScannedAt         DateTime?

  connectorVersion   String?
  intelligenceSource String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  editorialAssets EditorialAsset[]
}

model Product {
  id String @id @default(cuid())

  sourceProvider  String  @default("ALIEXPRESS")
  sourceProductId String
  sourceUrl       String
  sourceSellerId  String?

  sourceTitle       String  @db.Text
  sourceDescription String? @db.Text
  sourceCurrency    String?
  rawPayload        Json?

  costMin Decimal? @db.Decimal(12, 2)
  costMax Decimal? @db.Decimal(12, 2)

  optimizedTitle   String?
  headline         String? @db.Text
  shortDescription String? @db.Text
  benefits         Json?
  specifications   Json?
  cta              String? @db.Text

  seoTitle       String?
  seoDescription String? @db.Text

  recommendedPrice Decimal? @db.Decimal(12, 2)
  compareAtPrice   Decimal? @db.Decimal(12, 2)
  storeCurrency    String   @default("BRL")

  aiCopyVersion String?
  status        ProductStatus @default(IMPORTED)

  images       ProductImage[]
  variants     ProductVariant[]
  publications Publication[]
  orderItems   OrderItem[]

  importedAt                DateTime         @default(now())
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  editorialAssets           EditorialAsset[]
  editorialReferenceImageId String?

  @@unique([sourceProvider, sourceProductId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceUrl String    @db.Text
  storedUrl String?   @db.Text
  altText   String?
  imageType ImageType @default(GALLERY)

  sortOrder Int     @default(0)
  selected  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sourceSkuId String
  sku         String?
  attributes  Json

  costPrice      Decimal? @db.Decimal(12, 2)
  salePrice      Decimal? @db.Decimal(12, 2)
  sourceCurrency String?

  stock      Int?
  available  Boolean @default(true)
  imageUrl   String? @db.Text
  rawPayload Json?

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sourceSkuId])
  @@index([productId])
}

model EditorialAsset {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  assetType String
  batch     Int    @default(1)

  sourceImageUrl String @db.Text
  recipe         Json

  selected Boolean @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  generatedPath      String?  @db.Text
  generationProvider String?
  generationModel    String?
  prompt             String?  @db.Text
  seed               Int?
  fidelityScore      Float?

  audit Json?

  @@index([productId, storeId, batch])
  @@index([productId, storeId, selected])
}

model Publication {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  externalProductId String?
  externalSlug      String?
  externalUrl       String? @db.Text

  salePrice      Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  targetCategory String?
  targetAgeRange String?

  payload Json?

  githubBranch      String?
  githubCommitSha   String?
  pullRequestNumber Int?
  previewUrl        String? @db.Text

  status    PublicationStatus @default(DRAFT)
  lastError String?           @db.Text

  publishedAt  DateTime?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, status])
}

model Order {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  externalOrderId String

  status            OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currency       String   @default("BRL")
  subtotal       Decimal? @db.Decimal(12, 2)
  shippingAmount Decimal? @db.Decimal(12, 2)
  discountAmount Decimal? @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)

  customerName  String
  customerEmail String?
  customerPhone String?

  aliexpressOrderId String?
  trackingCode      String?
  trackingUrl       String? @db.Text
  carrier           String?

  orderedAliAt DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?

  shippingAddress ShippingAddress?
  items           OrderItem[]

  orderedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, externalOrderId])
  @@index([storeId, status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
}

model ShippingAddress {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipient    String
  line1        String
  line2        String?
  number       String?
  district     String?
  city         String
  state        String
  postalCode   String
  countryCode  String  @default("BR")
  instructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  titleSnapshot   String
  variantSnapshot Json?

  sourceSkuIdSnapshot String?
  sourceUrlSnapshot   String? @db.Text

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model IntegrationEvent {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  externalEventId String
  eventType       String
  status          EventStatus @default(RECEIVED)

  payload Json

  errorMessage String?   @db.Text
  processedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([storeId, externalEventId])
  @@index([storeId, eventType])
  @@index([status])
}
